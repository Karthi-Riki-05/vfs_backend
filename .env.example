# ============================================================
# Value Charts Backend — Environment Variables
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/value_charts_db"

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-chars
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OAuth Providers (for NextAuth in frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Stripe
# STRIPE_MODE controls which key set is used: 'test' (default) or 'live'
STRIPE_MODE=test

# Test mode keys (used when STRIPE_MODE=test)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...

# Live mode keys (used when STRIPE_MODE=live)
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...

# Legacy key (used as fallback when STRIPE_TEST_SECRET_KEY is not set)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_CURRENCY=usd

# Test-mode price IDs (run: node scripts/setup-stripe-products-v3.js with STRIPE_MODE=test)
STRIPE_TEST_PRODUCT_ID=prod_...
STRIPE_TEST_TEAM_MONTHLY_PRICE=price_...
STRIPE_TEST_TEAM_YEARLY_PRICE=price_...
STRIPE_TEST_PRO_BASE_PRICE=price_...
STRIPE_TEST_FLOW_STANDARD_PRICE_ID=price_...
STRIPE_TEST_FLOW_UNLIMITED_PRICE_ID=price_...
STRIPE_TEST_AI_ADDON_STARTER_PRICE=price_...
STRIPE_TEST_AI_ADDON_STANDARD_PRICE=price_...
STRIPE_TEST_AI_ADDON_PROPPACK_PRICE=price_...

# Live-mode price IDs (run: node scripts/setup-stripe-products-v3.js with STRIPE_MODE=live)
STRIPE_LIVE_PRODUCT_ID=prod_...
STRIPE_LIVE_TEAM_MONTHLY_PRICE=price_...
STRIPE_LIVE_TEAM_YEARLY_PRICE=price_...
STRIPE_LIVE_PRO_BASE_PRICE=price_...
STRIPE_LIVE_FLOW_STANDARD_PRICE_ID=price_...
STRIPE_LIVE_FLOW_UNLIMITED_PRICE_ID=price_...
STRIPE_LIVE_AI_ADDON_STARTER_PRICE=price_...
STRIPE_LIVE_AI_ADDON_STANDARD_PRICE=price_...
STRIPE_LIVE_AI_ADDON_PROPPACK_PRICE=price_...

# AI Services
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Firebase (FCM Push Notifications)
# 1. Firebase Console → Project Settings → Service accounts → Generate new private key
# 2. Open the downloaded JSON, copy these three fields here
# 3. PRIVATE_KEY contains real newlines — wrap in quotes and keep \n as-is
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mobile build gate (consumed by GET /api/v1/auth/mobile/app-version)
MOBILE_MIN_VERSION=1.0.0
MOBILE_CURRENT_VERSION=1.0.0
MOBILE_IOS_URL=
MOBILE_ANDROID_URL=

# PDF Export Server (optional — leave blank for browser-print fallback)
EXPORT_SERVER_URL=

# File Storage — set S3_STORAGE=true for S3, false (or omit) for local disk
S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_PUBLIC_URL=
S3_ENDPOINT=

# Email
EMAIL_FROM=noreply@valuechart.com
RESEND_API_KEY=

# Logging
LOG_LEVEL=info

# MySQL Source Databases (migration only)
MYSQL_VS_HOST=127.0.0.1
MYSQL_VS_USER=root
MYSQL_VS_PASS=
MYSQL_VS_DB=value_stream
MYSQL_ENT_DB=ent_value_chart
MYSQL_IND_DB=ind_value_chart
