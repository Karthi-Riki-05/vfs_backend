{
  "name": "value-charts-backend",
  "version": "1.0.0",
  "description": "Backend for Value Charts 2.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "migrate": "node src/utils/migrate-data.js",
    "full-migrate": "npm run prisma:push && npm run migrate",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --coverageDirectory=coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html --forceExit",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "perf:token": "node -e 'const h=require(\"http\");let d=\"\";const r=h.request({hostname:\"127.0.0.1\",port:5000,path:\"/api/v1/auth/validate\",method:\"POST\",headers:{\"Content-Type\":\"application/json\"}},x=>{x.on(\"data\",c=>d+=c);x.on(\"end\",()=>process.stdout.write((JSON.parse(d)?.data?.token)||\"\"))});r.write(JSON.stringify({email:\"prouser@valueflowtest.com\",password:\"Test@1234\"}));r.end();'",
    "test:performance": "sh tests/performance/run-all.sh",
    "test:perf": "NODE_OPTIONS=--require=./tests/performance/_node18-file-polyfill.js PERF_TOKEN=$(npm run --silent perf:token) npx artillery run tests/performance/scenarios/response-time.yml",
    "test:perf:load": "NODE_OPTIONS=--require=./tests/performance/_node18-file-polyfill.js PERF_TOKEN=$(npm run --silent perf:token) npx artillery run tests/performance/scenarios/load.yml",
    "test:perf:stress": "NODE_OPTIONS=--require=./tests/performance/_node18-file-polyfill.js PERF_TOKEN=$(npm run --silent perf:token) npx artillery run tests/performance/scenarios/stress.yml",
    "test:perf:spike": "NODE_OPTIONS=--require=./tests/performance/_node18-file-polyfill.js PERF_TOKEN=$(npm run --silent perf:token) npx artillery run tests/performance/scenarios/spike.yml",
    "test:perf:all": "sh tests/performance/run-all.sh",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/lib-storage": "^3.1043.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.14.0",
    "apple-signin-auth": "^2.0.0",
    "argon2": "^0.40.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dompurify": "^3.4.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "immer": "^11.1.4",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.18.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "open-graph-scraper": "^6.11.0",
    "openai": "^6.22.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
